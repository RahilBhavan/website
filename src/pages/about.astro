---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const timeline = [
  {
    when: 'Sep 2026',
    what: 'Spine: replayed Coinbase’s $1.6B Morpho loan book (67,000+ positions) through seven crash paths.',
    href: '/projects/spine-coinbase-loan-book-risk-model',
  },
  {
    when: 'Sep 2026',
    what: 'Co-founded Presto. Built the matching engine, DDEX ingester, and claim workflow.',
    href: 'https://prestorecovery.com',
  },
  {
    when: 'Sep 2026',
    what: 'Shipped the Fall 2026 rush platform for the Michigan Engineering Consulting Group.',
    href: '/projects/mecg-recruitment-platform',
  },
  {
    when: 'Aug 2026',
    what: 'Summer.fi: stop-loss stress test replaying the Aug 5, 2024 ETH crash on Aave V3 and Morpho.',
    href: '/projects/summer-fi-liquidation-risk-simulator',
  },
  {
    when: 'Apr 2026',
    what: 'Five-year financial trends pipeline for 200+ suppliers, for GM’s purchasing team.',
    href: '/projects/gm-supplier-benchmark-dashboard',
  },
  {
    when: 'Feb 2026',
    what: 'Consulting for OpenEden: competitive landscape, on-chain velocity, USDO supply cohorts.',
    href: '/projects/openeden-rwa-intelligence-suite',
  },
  {
    when: 'Dec 2024',
    what: 'Rust tool that replays DeFi exploits and flags the Euler invariant break 4 blocks early.',
    href: '/projects/smart-contract-invariant-monitor-and-guardian',
  },
  {
    when: 'May to Dec 2024',
    what: '8-bit computer from 200+ TTL chips; taught 30 students with it in Zimbabwe.',
    href: '/projects/8-bit-computer-from-ttl-logic',
  },
  {
    when: '2024',
    what: 'Pothole-mapping drone for Bulawayo. Second place at ZITF; presented to the President of Zimbabwe.',
    href: '/projects/pothole-detection-drone-for-zimbabwe-roads',
  },
];
---

<BaseLayout title="About" description="Rahil Bhavan: computer engineering and economics student at Michigan, co-founder of Presto, DeFi risk modelling, hardware builds. Born in Los Angeles, raised in Zimbabwe." ogType="profile">
  <main class="wrap page">
    <h1>About</h1>

    <section class="prose intro">
      <p>
        I was born in Los Angeles and grew up in Bulawayo, Zimbabwe. I'm now a computer engineering and
        economics student at the University of Michigan and a co-founder of <a href="https://prestorecovery.com">Presto</a>, a
        three-person company that finds music royalties the MLC and SoundExchange hold for the wrong party,
        or for nobody, and claims them. I built the matching engine, the DDEX ingester, and the claim
        workflow.
      </p>
      <p>
        The thread through my work is systems where being wrong costs money: liquidation engines, royalty
        ledgers, protocol invariants. I like fetching every position from public data, calibrating on the
        events that actually happened, and writing down the recommendation. My risk work so far covers
        Coinbase's on-chain loan book, Summer.fi's stop-loss automation, and OpenEden's tokenized T-bill
        products.
      </p>
      <p>
        I also build hardware when the lesson needs to be physical. The drone came out of driving on
        Bulawayo's roads. The TTL computer came out of teaching computer architecture without a lab.
      </p>
      <p>
        Off the clock: American football and soccer, football tactics, cooking, and books on design and
        philosophy. I reply to every email: <a href="mailto:rahil@bhavanzim.com">rahil@bhavanzim.com</a>.
      </p>
    </section>

    <section class="block">
      <h2 class="label">Timeline</h2>
      <ol class="timeline">
        {timeline.map((t) => (
          <li>
            <span class="when">{t.when}</span>
            <a href={t.href}>{t.what}</a>
          </li>
        ))}
      </ol>
    </section>

    <section class="block">
      <h2 class="label">Elsewhere</h2>
      <p>
        <a href="https://github.com/rahilbhavan">GitHub</a> ·
        <a href="https://www.linkedin.com/in/rahil-bhavan/">LinkedIn</a> ·
        <a href="/rss.xml">RSS</a>
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  h1 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .block {
    margin-top: 3rem;
  }

  .block h2 {
    margin-bottom: 0.75rem;
  }

  .block p {
    margin: 0;
  }

  .timeline {
    list-style: none;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding: 0.625rem 0;
    border-top: 1px solid var(--line);
  }

  .timeline a {
    text-decoration: none;
  }

  .timeline a:hover {
    text-decoration: underline;
  }

  .when {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-3);
    padding-top: 0.3rem;
  }

  @media (max-width: 480px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }
  }
</style>
