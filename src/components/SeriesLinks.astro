---
import { getCollection } from 'astro:content';

interface Props {
  seriesName: string;
  currentPart: number;
}

const { seriesName, currentPart } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => data.series?.name === seriesName && !data.draft))
  .sort((a, b) => a.data.series!.part - b.data.series!.part);
---

{posts.length > 1 && (
  <nav class="series" aria-label="Series">
    <span class="label">Series · {seriesName}</span>
    <ol>
      {posts.map((post) => (
        <li>
          {post.data.series!.part === currentPart ? (
            <span class="current">{post.data.title}</span>
          ) : (
            <a href={`/writing/${post.id.replace(/\.(md|mdx)$/, '')}`}>
              {post.data.title}
            </a>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .series {
    margin-bottom: 2.5rem;
    font-size: 0.9375rem;
  }

  .series .label {
    display: block;
    margin-bottom: 0.5rem;
  }

  .series ol {
    list-style: none;
  }

  .series li {
    padding: 0.5rem 0;
    border-top: 1px solid var(--line);
  }

  .series li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .series a {
    color: var(--fg-2);
    text-decoration: none;
  }

  .series a:hover {
    color: var(--fg);
  }

  .current {
    color: var(--fg);
  }
</style>
