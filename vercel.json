{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/orbit",
      "destination": "https://box.tail93593c.ts.net:10443/",
      "permanent": false
    },
    {
      "source": "/mara-credit-case",
      "destination": "https://mara.rahilbhavan.com/",
      "permanent": true
    },
    {
      "source": "/mara-credit-case/:path*",
      "destination": "https://mara.rahilbhavan.com/:path*",
      "permanent": true
    },
    {
      "source": "/riscv",
      "destination": "/riscv/post",
      "permanent": false
    }
  ]
}
