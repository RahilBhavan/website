---
import evidenceData from '../data/project-evidence.json';
type Row = { label: string; value: string; note: string; href?: string };
type Evidence = { id: string; label: string; title: string; basis: string; rows: Row[]; limit: string; source?: string; action?: string };
const evidence: Evidence[] = evidenceData;
const { projectId, artifact } = Astro.props;
const summary = evidence.find((entry) => entry.id === projectId);
---

{summary && <aside class="project-evidence" aria-labelledby="evidence-title">
  <p class="eyebrow">{summary.label}</p>
  <h2 id="evidence-title">{summary.title}</h2>
  <p class="stamp-row"><span class="stamp basis">✓ Checked · {summary.basis}</span></p>
  <dl>
    {summary.rows.map((row) => <div>
      <dt>{row.href ? <a href={row.href} rel="noopener">{row.label} ↗</a> : row.label}<span>{row.note}</span></dt>
      <dd>{row.value}</dd>
    </div>)}
  </dl>
  <div class="foot">
    <p class="limit"><b>Note:</b> {summary.limit}</p>
    {summary.source && <p class="source"><b>Source:</b> <a href={summary.source}>{summary.action} ↗</a></p>}
  </div>
  {artifact && <div class="source-artifact">
    <a href={artifact.src}>View the original project screenshot ↗</a>
    <p>{artifact.caption}</p>
  </div>}
</aside>}

<style>
  .project-evidence { background: var(--figure-surface); color: var(--figure-ink); padding: 1.5rem; border-radius: var(--radius-panel); border: 1px solid var(--figure-border); border-top: 6px solid var(--accent); min-width: 0; }
  .stamp-row { margin: 0; }
  .stamp { display: inline; padding: .2rem .6rem; background: var(--accent); color: #111214; font-size: 18px; font-weight: 800; letter-spacing: .02em; line-height: 1.9; text-transform: uppercase; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .foot { border-top: 1px solid var(--figure-border); margin-top: 1.5rem; padding-top: .5rem; }
  .foot p { margin: 0; }
  .foot b { font-weight: 800; color: var(--figure-ink); }
  dd { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .eyebrow, .limit, dt span, .source-artifact p { color: var(--figure-secondary); }
  .project-evidence p, .project-evidence a, dt, dd { font-size: 18px; line-height: 1.6; }
  .eyebrow { margin: 0; font-weight: 600; }
  h2 { font-size: 40px; line-height: 1.08; margin: 1rem 0; text-transform: none; }
  .basis { margin: 0; }
  dl { margin: 1.5rem 0; }
  dl > div { border-top: 1px solid var(--figure-border); padding: 1rem 0; }
  dd { margin: .5rem 0 0; font-weight: 400; }
  dt span { display: block; }
  dt a { font-weight: 600; }
  a { color: var(--figure-ink); display: inline-flex; align-items: center; min-height: 44px; text-decoration-color: var(--figure-secondary); }
  a:hover { background: var(--accent); color: #111214; }
  :focus-visible { outline-color: var(--figure-ink); }
  .source-artifact { border-top: 1px solid var(--figure-border); margin-top: 1.5rem; padding-top: 1rem; }
  .source-artifact p { margin: .5rem 0 0; }
</style>
