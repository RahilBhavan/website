---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = 'Rahil Bhavan, a computer engineering and economics student at Michigan, builds things to learn how they work: crypto lending risk models, a royalty recovery engine, AI infrastructure math and hardware. Each project shows its result and how it was checked.',
  ogImage,
  ogType = 'website',
} = Astro.props;

const siteName = 'Rahil Bhavan';
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const baseURL = Astro.site || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, baseURL);
const socialImageURL = new URL(ogImage ?? '/og/home.png', baseURL);

const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/textbooks', label: 'Textbooks' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F5F5EF" media="(prefers-color-scheme: light)" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Rahil Bhavan" href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    {/* Every card, generated or project-hosted, is 1280x640 */}
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <link rel="preload" href="/fonts/Archivo-VF.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="top-bar" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap-wide header-row">
        <a href="/" class="site-name"><span class="mark" aria-hidden="true"></span>Rahil Bhavan Research</a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap-wide footer-row">
        <span>© {new Date().getFullYear()} Rahil Bhavan</span>
        <span class="footer-links">
          <a href="mailto:rahil@bhavanzim.com">Email</a>
          <a href="https://github.com/rahilbhavan" rel="me">GitHub</a>
          <a href="https://www.linkedin.com/in/rahil-bhavan/" rel="me">LinkedIn</a>
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Rahil Bhavan Research identity, approved Oct 27, 2026. Archivo for text, IBM Plex Mono for figures. */
  @font-face {
    font-family: 'Archivo';
    src: url('/fonts/Archivo-VF.woff2') format('woff2');
    font-weight: 400 900;
    font-display: swap;
  }

  @font-face {
    font-family: 'Plex Mono';
    src: url('/fonts/IBMPlexMono-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }

  :root {
    --font-sans: 'Archivo', system-ui, sans-serif;
    --font-display: var(--font-sans);
    --font-mono: 'Plex Mono', ui-monospace, monospace;

    /* Dark is the default theme */
    --canvas: #111214;
    --surface: #202124;
    --ink: #f5f5ef;
    --secondary: #b7b8b1;
    --border: #424348;
    --accent: #ffe500;
    --on-accent: #111214;
    --focus: #ffe500;
    --hero: #ffe500;
    /* Evidence and figures stay on paper in both themes */
    --figure-surface: #f5f5ef;
    --figure-ink: #111214;
    --figure-secondary: #52545a;
    --figure-border: #c6c7bf;

    --radius-control: 8px;
    --radius-panel: 12px;
    --measure: calc(47.5rem + 2 * var(--gutter)); /* 760px of content */
    --wide: 75rem;
    --gutter: 1.5rem;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --canvas: #f5f5ef;
      --surface: #e9e9e2;
      --ink: #111214;
      --secondary: #52545a;
      --border: #c6c7bf;
      --focus: #111214;
      --hero: #111214;
      --figure-surface: #f5f5ef;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    font-size: 16px;
    color-scheme: dark light;
    scrollbar-color: var(--secondary) var(--canvas);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink);
    background: var(--canvas);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  ::selection {
    background: var(--accent);
    color: var(--canvas);
  }

  :focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  main {
    flex: 1;
    /* .wrap's auto margins stop flex stretch, so pin the width or wide tables widen the page */
    width: 100%;
  }

  /* Links are ink with a rule underline; yellow is only ever a fill behind ink text */
  a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--secondary);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  a:hover {
    background: var(--accent);
    color: var(--on-accent);
    text-decoration-color: var(--on-accent);
  }

  /* Signature device: yellow top bar and highlighter */
  .top-bar {
    height: 6px;
    background: var(--accent);
  }

  .hl {
    background: linear-gradient(transparent 6%, var(--accent) 6% 94%, transparent 94%);
    color: #111214;
    padding: 0 0.14em;
    margin: 0 -0.14em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .kicker {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .stamp {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: var(--accent);
    color: #111214;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  h1, h2, h3, h4 {
    margin: 0;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  h1, h2 {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0;
  }

  h1 {
    font-size: clamp(2.5rem, 6.4vw, 4.5rem);
  }

  h2 {
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
  }

  h3, h4 {
    font-weight: 600;
    line-height: 1.25;
  }

  ul, ol {
    margin: 0;
    padding: 0;
  }

  code, pre, kbd {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .skip {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 10;
    padding: 0.75rem 1rem;
    background: var(--surface);
    transform: translateY(-200%);
  }

  .skip:focus {
    transform: none;
  }

  /* Layout primitives used by every page */
  .wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .wrap-wide {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .page {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--secondary);
  }

  .muted {
    color: var(--secondary);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 1rem;
    color: var(--secondary);
    text-decoration: none;
  }

  .back:hover {
    color: var(--ink);
  }

  /* The one filled action per screen */
  .primary {
    padding: 0 1.25rem;
    border-radius: 8px;
    background: var(--accent);
    color: #111214;
    text-decoration: none;
  }

  .primary:hover {
    background: var(--ink);
    color: var(--canvas);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Status reads as text first; the yellow rule is only a marker */
  .status {
    display: inline-block;
    border-left: 3px solid var(--ink);
    padding-left: 0.625rem;
    font-size: 0.875rem;
    color: var(--secondary);
    white-space: nowrap;
  }

  .figure {
    margin: 0;
    padding: 1rem;
    background: var(--figure-surface);
    color: var(--figure-ink);
    border-radius: 12px;
    border: 1px solid var(--figure-border);
  }

  .figure img {
    display: block;
    width: 100%;
    border-radius: 6px;
  }

  .figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--figure-secondary);
  }

  .figure a,
  .figure a:hover {
    color: var(--figure-ink);
    text-decoration-color: var(--figure-secondary);
  }

  .figure :focus-visible {
    outline-color: var(--figure-ink);
  }

  .figure ::selection {
    color: var(--figure-ink);
  }

  /* Header and footer */
  .site-header {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .header-row, .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
  }

  .site-name {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }

  .site-name .mark {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--accent);
    flex: none;
  }

  .site-name:hover .mark {
    outline: 2px solid var(--on-accent);
    outline-offset: -2px;
  }

  .site-nav {
    display: flex;
    gap: .5rem 1.25rem;
    flex-wrap: wrap;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }

  .site-nav a {
    text-decoration: none;
    font-weight: 500;
  }

  .site-nav a[aria-current='page'] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.4em;
  }

  .site-footer {
    border-top: 4px solid var(--ink);
    padding: 1rem 0 2.5rem;
    font-size: 0.875rem;
    color: var(--secondary);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--secondary);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--on-accent);
  }

  /* Rendered markdown (project and writing bodies) */
  .prose {
    line-height: 1.7;
  }

  .prose > :first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .prose h2 {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    margin: 3rem 0 1rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    scroll-margin-top: 1rem;
  }

  .prose h3 {
    font-size: 1.1875rem;
    margin: 2rem 0 0.5rem;
  }

  .prose h4 {
    font-size: 1.0625rem;
    margin: 1.25rem 0 0.25rem;
    color: var(--secondary);
  }

  .prose p {
    margin: 0 0 1rem;
  }

  .prose ul, .prose ol {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li {
    margin: 0.25rem 0;
  }

  .prose li::marker {
    color: var(--secondary);
  }

  .prose li > ul, .prose li > ol {
    margin-bottom: 0;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose blockquote {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--ink);
    color: var(--secondary);
  }

  .prose code {
    background: var(--surface);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  .prose pre {
    background: var(--surface);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    line-height: 1.5;
  }

  .prose pre code {
    background: none;
    padding: 0;
    font-size: 0.8125rem;
  }

  .prose img {
    display: block;
    border-radius: 8px;
    margin: 1.5rem 0 0.5rem;
  }

  .prose img + em {
    display: block;
    font-size: 0.875rem;
    color: var(--secondary);
    margin-bottom: 1.5rem;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    margin: 1.25rem 0;
  }

  /* Wide tables scroll inside themselves on phones instead of widening the page */
  @media (max-width: 40rem) {
    .prose table {
      display: block;
      overflow-x: auto;
    }
  }

  .prose th, .prose td {
    text-align: left;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .prose th {
    font-weight: 600;
    color: var(--secondary);
    font-size: 0.8125rem;
  }

  /* Footnotes (remark-gfm) read as the page's Note line */
  .prose .footnotes {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--secondary);
  }

  .prose .footnotes h2 {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 0;
    margin: 0 0 0.5rem;
    padding: 0;
  }

  .prose sup a {
    font-weight: 700;
    text-decoration: none;
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  @media (max-width: 640px) {
    body {
      font-size: 1rem;
    }

    :root {
      --gutter: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
