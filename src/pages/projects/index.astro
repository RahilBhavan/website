---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

export const prerender = true

const projects = await getCollection('projects')
const sortedProjects = projects.sort(
  (a, b) => b.data.completedDate.valueOf() - a.data.completedDate.valueOf()
)
---

<BaseLayout
  title="Projects"
  description="Selected projects and consulting engagements, with write-ups, artifacts, and implementation details."
  ogType="website"
>
  <main class="projects-container">
    <header class="projects-header">
      <h1>Projects</h1>
      <p class="subtitle">Builds, research, and consulting work — documented like case studies.</p>
    </header>

    <section class="featured">
      <h2 class="section-title">Featured</h2>
      <article class="featured-card">
        <a class="featured-link" href="/projects/openeden-rwa-intelligence-suite">
          <div class="featured-content">
            <h3 class="featured-title">OpenEden RWA Intelligence Suite</h3>
            <p class="featured-description">
              Institutional-grade analysis across competitive landscape, on-chain velocity, and supply scenario modeling
              for a tokenized real-world asset protocol (PRISM + USDO).
            </p>
            <div class="featured-meta">
              <span class="featured-pill">Consulting</span>
              <span class="featured-separator">•</span>
              <span class="featured-pill">Python</span>
              <span class="featured-separator">•</span>
              <span class="featured-pill">Data + Charts</span>
              <span class="featured-separator">•</span>
              <time datetime="2026-02-27" class="featured-pill">Feb 27, 2026</time>
            </div>
          </div>
        </a>
      </article>
    </section>

    <section class="projects-grid-section">
      <h2 class="section-title">More projects</h2>

      {sortedProjects.length > 0 ? (
        <div class="projects-grid">
          {sortedProjects.map((project) => {
            const slug = project.id.replace(/\.(md|mdx)$/, '')
            return (
              <article class="project-card">
                <a href={`/projects/${slug}`} class="project-link">
                  <div class="project-content">
                    <h3 class="project-title">{project.data.title}</h3>
                    <p class="project-description">{project.data.description}</p>
                    <div class="project-meta">
                      <time datetime={project.data.completedDate.toISOString()} class="project-date">
                        {project.data.completedDate.toLocaleDateString('en-us', {
                          year: 'numeric',
                          month: 'short',
                        })}
                      </time>
                      {project.data.demoUrl && (
                        <>
                          <span class="project-meta-separator">•</span>
                          <span class="project-meta-link">demo</span>
                        </>
                      )}
                      {project.data.githubUrl && (
                        <>
                          <span class="project-meta-separator">•</span>
                          <span class="project-meta-link">code</span>
                        </>
                      )}
                    </div>
                  </div>
                </a>
              </article>
            )
          })}
        </div>
      ) : (
        <p class="empty-state">No projects published yet.</p>
      )}
    </section>
  </main>
</BaseLayout>

<style>
  .projects-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .projects-header {
    margin-bottom: 3rem;
    max-width: 700px;
  }

  .projects-header h1 {
    font-size: 2.5rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    color: #666;
    font-size: 1rem;
    margin: 0;
    font-family: var(--font-sans);
  }

  .section-title {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-dim);
    margin: 0 0 1.5rem 0;
    font-family: var(--font-sans);
  }

  .featured {
    margin-bottom: 3.5rem;
  }

  .featured-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #ffffff;
    transition: all 0.2s ease;
  }

  .featured-card:hover {
    border-color: #1a1a1a;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }

  .featured-link {
    display: block;
    padding: 2rem;
  }

  .featured-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .featured-description {
    color: #666;
    margin: 0;
    line-height: 1.6;
    max-width: 80ch;
  }

  .featured-meta {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    color: #666;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  .featured-pill {
    background: #f5f5f5;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .featured-separator {
    color: #bbb;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #ffffff;
    transition: all 0.2s ease;
  }

  .project-card:hover {
    border-color: #1a1a1a;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }

  .project-link {
    display: block;
    padding: 1.5rem;
    height: 100%;
  }

  .project-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
    color: #1a1a1a;
  }

  .project-description {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.55;
    margin: 0;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: #999;
  }

  .project-meta-separator {
    color: #bbb;
  }

  .project-meta-link {
    text-transform: lowercase;
  }

  .empty-state {
    color: #999;
    font-style: italic;
    font-family: var(--font-sans);
  }

  @media (max-width: 768px) {
    .projects-container {
      padding: 2rem 1.5rem;
    }

    .projects-header h1 {
      font-size: 2rem;
    }

    .featured-link {
      padding: 1.5rem;
    }
  }
</style>

