---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import TrackFilter from '../../components/TrackFilter.astro';
import { groupWriting, monthYear, slug } from '../../lib/content';

export const prerender = true;

const projectTracks = new Map((await getCollection('projects')).map((p) => [slug(p.id), p.data.track]));
const entries = groupWriting(
  await getCollection('blog', ({ data }) => !data.draft),
  (post) => (post.data.project ? projectTracks.get(post.data.project.id) : undefined)
);
const counts: Record<string, number> = {};
for (const e of entries) if (e.track) counts[e.track] = (counts[e.track] ?? 0) + 1;
---

<BaseLayout title="Writing" description="Write-ups and series on the projects: what was built, what broke and what the numbers say.">
  <main id="main" class="wrap page">
    <h1>Writing</h1>

    <TrackFilter target="#writing-list" counts={counts} noun="entries" />
    <ul class="entries" id="writing-list">
      {entries.map((entry) => (
        <li class="entry" data-track={entry.track}>
          <p class="entry-meta">
            {entry.parts.length > 0 && <>{entry.parts.length}-part series · </>}{monthYear(entry.date)}
          </p>
          <h2 class="entry-title"><a href={entry.href}>{entry.title}</a></h2>
          <p class="entry-sub">{entry.description}</p>
          {entry.parts.length > 0 && (
            <ol class="parts">
              {entry.parts.map((part) => (
                <li><a href={part.href}>{part.title}</a></li>
              ))}
            </ol>
          )}
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 2rem;
  }

  .entries {
    list-style: none;
  }

  .entry {
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }

  .entry-meta {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    color: var(--secondary);
  }

  .entry-title {
    font-family: var(--font-sans);
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.3;
    text-transform: none;
    margin-bottom: 0.5rem;
  }

  .entry-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .entry-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ink);
  }

  .entry-sub {
    margin: 0;
    color: var(--secondary);
  }

  .parts {
    margin: 0.75rem 0 0 1.25rem;
    font-size: 0.9375rem;
  }

  .parts li {
    padding: 0.2rem 0;
  }

  .parts li::marker {
    color: var(--secondary);
  }
</style>
