---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { getCollection } from 'astro:content';
import { groupWriting, monthYear, slug, statusLabel } from '../lib/content';

export const prerender = true;

const allProjects = (await getCollection('projects')).sort(
  (a, b) => b.data.completedDate.valueOf() - a.data.completedDate.valueOf() || a.id.localeCompare(b.id)
);
const featured = allProjects.filter((p) => p.data.featured);
const latest = allProjects[0];

const writing = groupWriting(await getCollection('blog', ({ data }) => !data.draft)).slice(0, 4);
---

<BaseLayout title="Rahil Bhavan">
  <main id="main" class="home">
    <section class="wrap-wide hero">
      <p class="kicker hero-kicker">Research and projects · University of Michigan</p>
      <h1 class="personal-name">Rahil Bhavan</h1>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-lead"><span class="hl">A student trynna learn.</span></p>
          <p>
            I study computer engineering and economics at the University of Michigan and co-founded{' '}
            <a href="https://prestorecovery.com">Presto</a>, which finds music royalties held for the wrong
            party, or for nobody, and claims them.
          </p>
          <p>
            I learn by building the thing and writing down how I checked it. So far that means stress tests of
            crypto lending books, credit and payments cases built from public filings, LLM tools that have to quote
            the SEC filing they answer from, a datacenter calculator, a pothole-mapping drone and an 8-bit
            computer I used to teach 30 students.
          </p>
          <p class="muted">Born in Los Angeles, raised in Zimbabwe.</p>
          <p class="hero-actions">
            <a href="#work" class="primary">See the projects</a>
            <a href="mailto:rahil@bhavanzim.com">Email me</a>
          </p>
        </div>

        <aside class="latest" aria-labelledby="latest-label">
          <p id="latest-label" class="label">Latest project · {monthYear(latest.data.completedDate)}</p>
          <h2 class="latest-title">
            <a href={`/projects/${slug(latest.id)}`}>{latest.data.title}</a>
          </h2>
          <p class="latest-result">{latest.data.result}</p>
          <p class="latest-meta">
            <span class="status">{statusLabel[latest.data.status]}</span>
            <span>{latest.data.verification}</span>
          </p>
        </aside>
      </div>
    </section>

    <section id="work" class="wrap-wide block" aria-labelledby="work-title">
      <div class="block-head">
        <h2 id="work-title">Selected work</h2>
        <p class="block-links">
          <a href="/projects">All {allProjects.length} projects</a>
          <a href="/crypto-finance">Crypto finance case studies</a>
        </p>
      </div>
      <div class="work-grid">
        {featured.map((project) => <ProjectEntry project={project} />)}
      </div>
    </section>

    <section class="wrap-wide block" aria-labelledby="writing-title">
      <div class="block-head">
        <h2 id="writing-title">Writing</h2>
        <p class="block-links"><a href="/writing">All writing</a></p>
      </div>
      <ul class="writing">
        {writing.map((entry) => (
          <li>
            <a href={entry.href} class="writing-title">{entry.title}</a>
            <span class="writing-meta">
              {entry.parts.length > 0 && <>{entry.parts.length} parts · </>}{monthYear(entry.date)}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrap-wide block" aria-labelledby="textbooks-title">
      <div class="block-head"><h2 id="textbooks-title">Go deeper</h2><p class="block-links"><a href="/textbooks">Browse all 11 textbooks</a></p></div>
      <p class="textbook-intro">The long version of the projects: RISC-V pipelines, commodity risk, tokenization, GPU kernels and the foundations underneath them. Worked examples, diagrams and questions to test what makes sense.</p>
    </section>

    <section class="wrap-wide block contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <p>
        I reply to email at <a href="mailto:rahil@bhavanzim.com">rahil@bhavanzim.com</a> and take on a small
        number of DeFi risk engagements. I'm also on <a href="https://github.com/rahilbhavan">GitHub</a> and{' '}
        <a href="https://www.linkedin.com/in/rahil-bhavan/">LinkedIn</a>.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    counter-reset: section;
    padding-bottom: 5rem;
  }

  .personal-name {
    font-size: clamp(3.5rem, 12vw, 10rem);
    line-height: 0.95;
    font-stretch: 100%;
    margin: 0 0 2.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 3rem 4.5rem;
    align-items: start;
  }

  .hero-copy p {
    margin: 0 0 1rem;
    max-width: 38rem;
  }

  .hero-kicker {
    margin-top: 3rem;
  }

  .hero-lead {
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    font-weight: 800;
    line-height: 1.25;
    color: var(--ink);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem !important;
  }

  .hero-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  .latest {
    padding: 1.5rem;
    background: var(--surface);
    border-radius: 12px;
    border-top: 4px solid var(--ink);
  }

  .latest .label {
    margin: 0 0 0.75rem;
  }

  .latest-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin-bottom: 0.75rem;
  }

  .latest-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .latest-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--link);
  }

  .latest-result {
    margin: 0 0 1rem;
  }

  .latest-meta {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.875rem;
    color: var(--secondary);
  }

  .latest-meta .status {
    justify-self: start;
  }

  .block {
    margin-top: 5rem;
    counter-increment: section;
  }

  .block-head h2::before {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .block-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    margin-bottom: 1rem;
  }

  .block-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
  }

  .block-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 3rem;
  }

  .writing {
    list-style: none;
  }

  .writing li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  .writing-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }

  .writing-title:hover {
    text-decoration: underline;
    text-decoration-color: var(--link);
  }

  .writing-meta {
    font-size: 0.875rem;
    color: var(--secondary);
    white-space: nowrap;
  }

  .textbook-intro { max-width: 64ch; }

  .contact p {
    margin: 1rem 0 0;
    max-width: 44rem;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .work-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
