---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => {
    const slug = project.id.replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { project },
    };
  });
}

const { project } = Astro.props;
const { Content } = await project.render();
const { data } = project;
const month = data.completedDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<BaseLayout title={data.title} description={data.description} ogImage={data.ogImage} ogType="article">
  <main class="wrap page">
    <a href="/projects" class="label back">← Projects</a>
    <h1>{data.title}</h1>
    <p class="muted lede">{data.description}</p>
    <div class="label meta">
      {data.kind && <span>{data.kind}</span>}
      <time datetime={data.completedDate.toISOString()}>{month}</time>
      {data.demoUrl && <a href={data.demoUrl} rel="noopener">demo</a>}
      {data.githubUrl && <a href={data.githubUrl} rel="noopener">code</a>}
    </div>

    <dl class="kicker">
      <dt class="label">Problem</dt>
      <dd>{data.problem}</dd>
      <dt class="label">Solution</dt>
      <dd>{data.solution}</dd>
    </dl>

    <div class="prose"><Content /></div>
  </main>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .back:hover {
    color: var(--fg);
  }

  h1 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .lede {
    margin: 0 0 1rem;
    font-size: 1.0625rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .meta a {
    color: var(--fg-2);
    text-decoration: underline;
    text-decoration-color: var(--fg-3);
  }

  .meta a:hover {
    color: var(--fg);
  }

  .kicker {
    margin: 0 0 3rem;
  }

  .kicker dt {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .kicker dd {
    margin: 0.25rem 0 1rem;
  }
</style>
