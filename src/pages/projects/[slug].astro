---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import ProjectEvidence from '../../components/ProjectEvidence.astro';
import { getCollection, render } from 'astro:content';
import { demoLabel, groupWriting, monthYear, slug, splitTitle, statusLabel } from '../../lib/content';
import evidence from '../../data/project-evidence.json';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: slug(project.id) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const { data } = project;
const studyPages = new Set([
  'strategy-preferred-coverage-model-dividend-runway', 'dat-accretion-monitor',
  'mara-credit-case', 'spine-coinbase-loan-book-risk-model',
  'presto-royalty-recovery-engine', 'mev-sandwich-study-two-phase-clearing-on-uniswap',
  'strategy-capital-markets-toolkit',
]);
const isStudy = studyPages.has(slug(project.id));
const sections = headings.filter((heading) => heading.depth === 2);
const [titleBefore, titleKey, titleAfter] = splitTitle(data.title);
// The hero number is the finding's own value, so it shows only when an evidence row is marked `"hero": true`; a first row picked by position can contradict the finding sentence.
const hero = isStudy ? evidence.find((entry) => entry.id === slug(project.id))?.rows.find((row) => (row as { hero?: boolean }).hero) : undefined;

const writing = groupWriting(
  await getCollection('blog', (post) => !post.data.draft && post.data.project?.id === slug(project.id))
);

const facts = [
  { term: 'Problem', detail: data.problem },
  { term: 'Approach', detail: data.solution },
  { term: 'How it was checked', detail: data.verification },
  ...(data.next ? [{ term: 'Still open', detail: data.next }] : []),
];
---

<BaseLayout title={data.title} description={data.description} ogImage={data.ogImage ?? `/og/${slug(project.id)}.png`} ogType="article">
  <main id="main" class:list={['page', { 'project-study': isStudy }]}>
    <header class="wrap-wide case-head">
      <a href="/projects" class="back">← All projects</a>
      <p class="case-meta">
        <span class="status">{statusLabel[data.status]}</span>
        {data.kind && <span>{data.kind}</span>}
        <time datetime={data.completedDate.toISOString()}>{monthYear(data.completedDate)}</time>
      </p>
      <h1>{titleBefore}<span class="hl">{titleKey}</span>{titleAfter}</h1>
      {isStudy && <p class="finding-label">The finding</p>}
      {hero && <p class="hero-number" aria-hidden="true">{hero.value}</p>}
      <p class="result">{data.result}</p>
      {(data.demoUrl || data.githubUrl) && (
        <p class="case-links">
          {data.demoUrl && <a href={data.demoUrl} rel="noopener" class="primary">{demoLabel(data.demoUrl)}</a>}
          {data.githubUrl && <a href={data.githubUrl} rel="noopener">Read the code</a>}
        </p>
      )}
      {isStudy && <a href="#project-write-up" class="write-up-shortcut">Jump to the full write-up ↓</a>}
    </header>

    <section class={`wrap-wide case-layout${data.figure || isStudy ? '' : ' no-figure'}`} aria-label="Summary">
      <dl class="facts">
        {facts.map((f) => (
          <div>
            <dt>{f.term}</dt>
            <dd>{f.detail}</dd>
          </div>
        ))}
      </dl>
      {isStudy && <div class="evidence-slot"><ProjectEvidence projectId={slug(project.id)} artifact={data.figure} /></div>}
      {!isStudy && data.figure && (
        <figure class="figure">
          <a href={data.figure.src} class="figure-link">
            <img src={data.figure.src} alt={data.figure.alt} loading="eager" />
            <span class="sr-only">Open the full-size image</span>
          </a>
          <figcaption>{data.figure.caption}</figcaption>
        </figure>
      )}
    </section>

    {writing.length > 0 && (
      <section class="wrap-wide related" aria-labelledby="related-title">
        <h2 id="related-title" class="label">Writing about this project</h2>
        <ul>
          {writing.flatMap((w) => (w.parts.length ? w.parts : [w])).map((p) => (
            <li><a href={p.href}>{p.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <div class:list={['write-up', isStudy ? 'wrap-wide study-reading' : 'wrap']}>
      {isStudy && <aside class="study-index">
        <p class="label">Inside the project</p>
        <nav aria-label="Case study sections"><ol>
          {sections.map((heading, index) => <li><a href={'#'.concat(heading.slug)}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a></li>)}
        </ol></nav>
        <a href="/projects" class="index-back">Explore all projects ↗</a>
      </aside>}
      <article class="study-article" id="project-write-up">
      <h2 class="write-up-title">The full write-up</h2>
      {!isStudy && <Toc headings={headings} />}
      <div class="prose"><Content /></div>
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  .case-head h1 {
    max-width: 22ch;
    margin-bottom: 1.25rem;
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin: 0 0 1rem;
    font-size: 0.875rem;
    color: var(--secondary);
  }

  .result {
    font-size: clamp(1.1875rem, 2vw, 1.375rem);
    line-height: 1.5;
    max-width: 48rem;
    margin: 0;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin: 1.5rem 0 0;
  }

  .case-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  .case-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
    margin-top: 3rem;
  }

  .case-layout.no-figure {
    grid-template-columns: minmax(0, 52rem);
  }

  .facts {
    margin: 0;
  }

  .facts > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }

  .facts dt {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--secondary);
    padding-top: 0.15rem;
  }

  .facts dd {
    margin: 0;
    min-width: 0;
  }

  .figure-link {
    display: block;
    border-radius: 0;
  }

  .related {
    margin-top: 2.5rem;
  }

  .related ul {
    list-style: none;
    margin-top: 0.5rem;
  }

  .related li {
    padding: 0.25rem 0;
  }

  .write-up {
    margin-top: 4rem;
  }

  .write-up-title {
    padding-top: 2rem;
    border-top: 4px solid var(--ink);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 900px) {
    .case-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 540px) {
    .facts > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }

  .project-study { font-size: 18px; line-height: 1.6; }
  .project-study .case-head { padding-top: 1rem; }
  .project-study .case-meta { margin-top: 2rem; }
  .project-study .case-head h1 {
    font-size: clamp(56px, 7.5vw, 96px);
    line-height: 1.06;
    letter-spacing: 0;
    max-width: 19ch;
    margin: 1.5rem 0 3rem;
    text-wrap: balance;
  }
  .write-up-shortcut { display: inline-flex; align-items: center; min-height: 44px; margin-top: 1rem; font-size: .9375rem; color: var(--secondary); }
  .finding-label { color: var(--secondary); font-size: .8125rem; margin: 0 0 .5rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .hero-number { margin: 0 0 .75rem; font-size: clamp(3.5rem, 9vw, 7rem); line-height: 1; font-weight: 800; color: var(--hero); letter-spacing: -.01em; overflow-wrap: anywhere; }
  .project-study .result { max-width: 48ch; font-size: clamp(1.25rem, 2.2vw, 1.625rem); line-height: 1.5; }
  .project-study .case-links { margin-top: 2rem; }
  .project-study .case-links a { padding: .75rem 1rem; border: 1px solid var(--border); text-decoration: none; border-radius: var(--radius-control); }
  .project-study .case-links .primary { border-color: var(--accent); }
  .project-study .case-links a:not(.primary) { text-decoration: none; }
  .project-study .case-layout { margin-top: 4rem; gap: 4rem; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .project-study .case-layout.no-figure { grid-template-columns: minmax(0, 56rem); }
  .project-study .facts > div { padding: 1.5rem 0; grid-template-columns: 8rem minmax(0, 1fr); }
  .project-study .figure { border-radius: var(--radius-panel); padding: 1.5rem; }
  .project-study .figure img, .project-study .figure-link { border-radius: var(--radius-control); }
  .study-reading { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 8fr); gap: 4rem; margin-top: 7rem; }
  .study-index { align-self: start; position: sticky; top: 2rem; border-top: 1px solid var(--border); padding-top: 2rem; }
  .study-index ol { list-style: none; margin-top: 1rem; }
  .study-index li a { display: grid; grid-template-columns: 1.5rem 1fr; gap: .5rem; align-items: baseline; min-height: 44px; padding: .625rem 0; font-size: .9375rem; text-decoration: none; color: var(--secondary); }
  .study-index a:hover, .study-index a:focus-visible { color: var(--on-accent); }
  .study-index li span { font-family: var(--font-mono); font-size: .875rem; }
  .index-back { display: inline-flex; min-height: 44px; align-items: center; font-size: .875rem; margin-top: 1.5rem; }
  .study-article { min-width: 0; }
  .project-study .write-up-title { font-size: .8125rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--secondary); padding-top: 2rem; }
  .project-study :global(.prose) { counter-reset: exhibit; }
  .project-study :global(.prose h2)::before { counter-increment: exhibit; content: 'Exhibit ' counter(exhibit, decimal-leading-zero); display: block; margin-bottom: .5rem; font-family: var(--font-mono); font-size: .8125rem; font-weight: 400; letter-spacing: .06em; text-transform: uppercase; color: var(--secondary); }
  .project-study :global(.prose h2) { margin-top: 4rem; padding-top: 1rem; scroll-margin-top: 2rem; }
  .project-study :global(.prose h2:first-child) { margin-top: 0; }
  .project-study :global(.prose) { max-width: 66ch; line-height: 1.6; }
  @media (max-width: 900px) {
    .project-study .case-layout { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .project-study .case-layout .evidence-slot { grid-row: 1; }
    .study-reading { grid-template-columns: minmax(0, 1fr); gap: 2rem; margin-top: 4rem; }
    .study-index { position: static; }
    .study-index ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; }
  }
  @media (max-width: 540px) {
    .project-study .case-head h1 { margin-bottom: 2rem; }
    .project-study .case-meta { margin-top: 1rem; }
    .project-study .facts > div { grid-template-columns: minmax(0, 1fr); gap: .5rem; }
    .project-study .case-layout { margin-top: 3rem; }
    .study-index ol { grid-template-columns: minmax(0, 1fr); }
  }
</style>
