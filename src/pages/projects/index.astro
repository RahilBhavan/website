---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectEntry from '../../components/ProjectEntry.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.completedDate.valueOf() - a.data.completedDate.valueOf()
);

const description =
  'Builds, risk models and consulting work, newest first. Each one says whether it is a proposal, a prototype or shipped, and how it was checked.';
---

<BaseLayout title="Projects" description={description}>
  <main id="main" class="wrap-wide page">
    <h1>Projects</h1>
    <p class="intro muted">{description}</p>
    <p class="hub">
      <a href="/crypto-finance">Crypto finance case studies</a> collects four projects on crypto lending, payments
      and revenue.
    </p>

    <div class="grid">
      {projects.map((project) => <ProjectEntry project={project} headingLevel="h2" />)}
    </div>
  </main>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 1rem;
  }

  .intro {
    margin: 0 0 0.5rem;
    max-width: 44rem;
  }

  .hub {
    margin: 0 0 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 3rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
