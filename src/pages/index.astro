---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.completedDate.valueOf() - a.data.completedDate.valueOf());

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);

const slug = (id: string) => id.replace(/\.(md|mdx)$/, '');
const year = (d: Date) => d.getFullYear();
const month = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<BaseLayout title="Rahil Bhavan">
  <main class="wrap page home">
    <section class="intro">
      <h1>I build risk models for on-chain lending, hardware that teaches, and Presto.</h1>
      <p>
        I'm an engineering student at the University of Michigan and a co-founder of
        <a href="https://prestorecovery.com">Presto</a>, which finds music royalties that the MLC and
        SoundExchange hold for the wrong party, or for nobody, and claims them.
      </p>
      <p>
        Most of my other work is risk modelling for DeFi lending. I replayed Coinbase's $1.6B Morpho loan
        book through seven crash paths (<a href="/projects/spine-coinbase-loan-book-risk-model">Spine</a>),
        stress-tested stop-loss buffers on Aave and Morpho for
        <a href="/projects/summer-fi-liquidation-risk-simulator">Summer.fi</a>, and did competitive and
        on-chain analysis for <a href="/projects/openeden-rwa-intelligence-suite">OpenEden</a>. Before that
        I built a <a href="/projects/pothole-detection-drone-for-zimbabwe-roads">pothole-mapping drone</a>
        in Bulawayo that placed second at ZITF and was presented to the President of Zimbabwe, and an
        <a href="/projects/8-bit-computer-from-ttl-logic">8-bit computer</a> from 200+ TTL chips that I
        used to teach 30 students.
      </p>
      <p class="muted">Born in Los Angeles, raised in Zimbabwe.</p>
    </section>

    <section class="block">
      <div class="block-head">
        <h2 class="label">Currently</h2>
        <span class="label">Sep 2026</span>
      </div>
      <p>
        Building Presto's recovery engine and keeping
        <a href="https://rahilbhavan.github.io/spine">Spine's dashboard</a> refreshing hourly. I take on a
        small number of DeFi risk engagements; <a href="mailto:rahil@bhavanzim.com">email me</a>.
      </p>
    </section>

    <section class="block">
      <div class="block-head">
        <h2 class="label">Building</h2>
        <a href="/projects" class="label more">All projects</a>
      </div>
      <ul class="rows">
        {projects.map((p) => (
          <li class="row">
            <div class="row-main">
              <a href={`/projects/${slug(p.id)}`} class="row-title">{p.data.title}</a>
              <span class="row-sub">{p.data.tagline}</span>
              <span class="row-links">
                {p.data.demoUrl && <a href={p.data.demoUrl}>demo</a>}
                {p.data.githubUrl && <a href={p.data.githubUrl}>code</a>}
              </span>
            </div>
            <span class="row-meta">{year(p.data.completedDate)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <div class="block-head">
        <h2 class="label">Writing</h2>
        <a href="/writing" class="label more">All writing</a>
      </div>
      <ul class="rows">
        {posts.map((post) => (
          <li class="row">
            <a href={`/writing/${slug(post.id)}`} class="row-title">{post.data.title}</a>
            <span class="row-meta">{month(post.data.publishDate)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2 class="label">Contact</h2>
      <p>
        I reply to email: <a href="mailto:rahil@bhavanzim.com">rahil@bhavanzim.com</a>. Also on
        <a href="https://github.com/rahilbhavan">GitHub</a> and
        <a href="https://www.linkedin.com/in/rahil-bhavan/">LinkedIn</a>.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .intro h1 {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    max-width: 30ch;
  }

  .intro p {
    margin: 0 0 1rem;
  }

  .block {
    margin-top: 3rem;
  }

  .block > p {
    margin: 0;
  }

  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }

  .block h2 {
    margin-bottom: 0.75rem;
  }

  .block-head h2 {
    margin-bottom: 0;
  }

  .more {
    text-decoration: none;
  }

  .more:hover {
    color: var(--fg);
  }

  .rows {
    list-style: none;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .row-title {
    font-weight: 500;
    text-decoration: none;
  }

  .row-title:hover {
    text-decoration: underline;
  }

  .row-sub {
    color: var(--fg-2);
    font-size: 0.9375rem;
  }

  .row-links {
    display: flex;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-3);
  }

  .row-links:empty {
    display: none;
  }

  .row-links a {
    text-decoration: none;
  }

  .row-links a:hover {
    color: var(--fg);
  }

  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-3);
    white-space: nowrap;
    padding-top: 0.25rem;
  }
</style>
