---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = 'Rahil Bhavan builds risk models for on-chain lending, hardware that teaches, and Presto, a royalty recovery company.',
  ogImage,
  ogType = 'website',
} = Astro.props;

const siteName = 'Rahil Bhavan';
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const baseURL = Astro.site || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, baseURL);
const socialImageURL = new URL(ogImage ?? '/og.png', baseURL);

const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Rahil Bhavan" href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    {ogImage && (
      <>
        {/* ponytail: every custom card is 1280x640; add props if one differs */}
        <meta property="og:image:width" content="1280" />
        <meta property="og:image:height" content="640" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        <a href="/" class="site-name">Rahil Bhavan</a>
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap footer-row">
        <span>© {new Date().getFullYear()} Rahil Bhavan</span>
        <span class="footer-links">
          <a href="mailto:rahil@bhavanzim.com">Email</a>
          <a href="https://github.com/rahilbhavan" rel="me">GitHub</a>
          <a href="https://www.linkedin.com/in/rahil-bhavan/" rel="me">LinkedIn</a>
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;

    --bg: #ffffff;
    --bg-2: #f6f6f6;
    --fg: #111111;
    --fg-2: #555555;
    --fg-3: #767676;
    --line: #e6e6e6;

    --wrap: 42.5rem;
    --gutter: 1.25rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f0f;
      --bg-2: #1a1a1a;
      --fg: #ececec;
      --fg-2: #a3a3a3;
      --fg-3: #808080;
      --line: #262626;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    line-height: 1.6;
    color: var(--fg);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    /* .wrap's auto margins stop flex stretch, so pin the width or wide tables widen the page */
    width: 100%;
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s;
  }

  a:hover {
    text-decoration-color: var(--fg);
  }

  h1, h2, h3, h4 {
    margin: 0;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  ul, ol {
    margin: 0;
    padding: 0;
  }

  code, pre, kbd {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* Layout primitives used by every page */
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .page {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .muted {
    color: var(--fg-2);
  }

  /* Header and footer */
  .site-header {
    padding: 1.5rem 0;
  }

  .header-row, .footer-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-name {
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }

  .site-nav a {
    color: var(--fg-2);
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--fg);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 1.5rem 0 2.5rem;
    font-size: 0.8125rem;
    color: var(--fg-3);
  }

  .footer-links {
    display: flex;
    gap: 1rem;
  }

  .footer-links a {
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  /* Rendered markdown (project and writing bodies) */
  .prose {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose > :first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .prose h2 {
    font-size: 1.25rem;
    margin: 2.5rem 0 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .prose h3 {
    font-size: 1.0625rem;
    margin: 1.75rem 0 0.5rem;
  }

  .prose h4 {
    font-size: 1rem;
    margin: 1.25rem 0 0.25rem;
    color: var(--fg-2);
  }

  .prose p {
    margin: 0 0 1rem;
  }

  .prose ul, .prose ol {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li {
    margin: 0.25rem 0;
  }

  .prose li > ul, .prose li > ol {
    margin-bottom: 0;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose blockquote {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--line);
    color: var(--fg-2);
  }

  .prose code {
    background: var(--bg-2);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  .prose pre {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.25rem 0;
    line-height: 1.5;
  }

  .prose pre code {
    background: none;
    padding: 0;
    font-size: 0.8125rem;
  }

  .prose img {
    display: block;
    border-radius: 6px;
    margin: 1.5rem 0 0.5rem;
  }

  .prose img + em {
    display: block;
    font-size: 0.875rem;
    color: var(--fg-3);
    margin-bottom: 1.5rem;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin: 1.25rem 0;
  }

  /* Wide tables scroll inside themselves on phones instead of widening the page */
  @media (max-width: 40rem) {
    .prose table {
      display: block;
      overflow-x: auto;
    }
  }

  .prose th, .prose td {
    text-align: left;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .prose th {
    font-weight: 600;
    color: var(--fg-2);
    font-size: 0.8125rem;
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2rem 0;
  }

  .prose a {
    text-decoration-color: var(--fg-3);
  }

  @media (max-width: 640px) {
    .prose {
      font-size: 1rem;
    }
  }
</style>
