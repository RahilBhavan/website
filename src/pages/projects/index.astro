---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.completedDate.valueOf() - a.data.completedDate.valueOf());

const slug = (id: string) => id.replace(/\.(md|mdx)$/, '');
const year = (d: Date) => d.getFullYear();
---

<BaseLayout
  title="Projects"
  description="Builds, risk models, and consulting work, each with the code or demo where it exists."
>
  <main class="wrap page">
    <h1>Projects</h1>
    <p class="muted">Builds, risk models, and consulting work, each with the code or demo where it exists.</p>
    <p class="hub"><a href="/crypto-finance">Crypto finance case studies</a>: four projects on crypto lending, payments and revenue.</p>

    <ul class="rows">
      {projects.map((p) => (
        <li class="row">
          <div class="row-main">
            <a href={`/projects/${slug(p.id)}`} class="row-title">{p.data.title}</a>
            <span class="row-sub">{p.data.tagline}</span>
            <span class="row-links">
              {p.data.demoUrl && <a href={p.data.demoUrl}>demo</a>}
              {p.data.githubUrl && <a href={p.data.githubUrl}>code</a>}
            </span>
          </div>
          <span class="row-meta">
            {p.data.kind && <>{p.data.kind} · </>}{year(p.data.completedDate)}
          </span>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  h1 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  h1 + p {
    margin: 0 0 1rem;
  }

  .hub {
    margin: 0 0 2rem;
    font-size: 0.9375rem;
  }

  .rows {
    list-style: none;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .row-title {
    font-weight: 500;
    text-decoration: none;
  }

  .row-title:hover {
    text-decoration: underline;
  }

  .row-sub {
    color: var(--fg-2);
    font-size: 0.9375rem;
  }

  .row-links {
    display: flex;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-3);
  }

  .row-links:empty {
    display: none;
  }

  .row-links a {
    text-decoration: none;
  }

  .row-links a:hover {
    color: var(--fg);
  }

  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-3);
    white-space: nowrap;
    padding-top: 0.25rem;
  }
</style>
