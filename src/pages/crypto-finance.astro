---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { getEntry } from 'astro:content';

export const prerender = true;

const description =
  'Four independent projects on how crypto lending, payments and revenue work, built from public data. Each has a live demo, a write-up and the code.';

const slugs = [
  'spine-coinbase-loan-book-risk-model',
  'mara-credit-case',
  'coin-revenue-bridge',
  'x402-exception-desk',
];
const projects = await Promise.all(
  slugs.map(async (slug) => {
    const project = await getEntry('projects', slug);
    if (!project) throw new Error(`crypto-finance: no project ${slug}`);
    return project;
  })
);
---

<BaseLayout title="Crypto finance case studies" description={description} ogImage="/og/crypto-finance.png">
  <main id="main" class="wrap page">
    <h1>Crypto finance case studies</h1>
    <p class="muted intro">
      Four independent projects on how crypto lending, payments and revenue work, built from public
      data. Each has a live demo, a write-up and the code.
    </p>

    <div class="cards">
      {projects.map((project) => <ProjectEntry project={project} headingLevel="h2" />)}
    </div>

    <p class="label note">Not affiliated with or endorsed by Coinbase, MARA or Morpho.</p>
  </main>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 1rem;
  }

  .intro {
    margin: 0 0 2rem;
  }

  .note {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>
