---
import BaseLayout from '../layouts/BaseLayout.astro';
import analytics from '../data/analytics.json';

const { overview, authors, goals, insights } = analytics;
---

<BaseLayout title="Reading Analytics" description="Detailed insights and statistics about my reading journey.">
  <main class="analytics-container">
    <header class="analytics-header">
      <h1>Reading Analytics</h1>
      <p class="subtitle">A data-driven look at my library and habits.</p>
    </header>

    <!-- Reading Progress -->
    <section class="stat-section progress-card">
      <div class="progress-info">
        <h2 class="section-title">2026 Reading Goal</h2>
        <span class="progress-numbers">{goals.booksThisYear} / {goals.targetThisYear} books</span>
      </div>
      <div class="progress-bar-container">
        <div class="progress-bar" style={`width: ${goals.progress}%`}></div>
      </div>
      <p class="progress-status">
        {goals.onTrack ? "✅ You're on track to hit your goal!" : "📉 You're currently behind your reading target."}
      </p>
    </section>

    <!-- Key Stats Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-value">{overview.totalBooks}</span>
        <span class="stat-label">Total Books Read</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">{overview.currentlyReading}</span>
        <span class="stat-label">Currently Reading</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">{overview.averageRating} ★</span>
        <span class="stat-label">Average Rating</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">{insights.authorDiversity.uniqueAuthors}</span>
        <span class="stat-label">Unique Authors</span>
      </div>
    </div>

    <div class="details-layout">
      <!-- AI Insights -->
      <section class="stat-section insights-box">
        <h2 class="section-title">AI Insights</h2>
        <div class="insight-content">
          <p class="ai-summary">{insights.summary}</p>
          <div class="insight-meta">
             <div class="streak">
               <span class="meta-label">Current Streak</span>
               <span class="meta-value">{insights.readingStreak.currentStreak} months</span>
             </div>
             <div class="consistency">
               <span class="meta-label">Consistency</span>
               <span class="meta-value">{insights.readingStreak.consistency}</span>
             </div>
          </div>
        </div>
      </section>

      <!-- Top Authors -->
      <section class="stat-section authors-box">
        <h2 class="section-title">Top Authors</h2>
        <ul class="author-list">
          {insights.authorDiversity.topAuthors.slice(0, 5).map(author => (
            <li class="author-item">
              <span class="author-name">{author.author}</span>
              <span class="author-count">{author.count} books</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <footer class="analytics-footer">
      <p>Last updated: {new Date(analytics.generatedAt).toLocaleDateString()}</p>
    </footer>
  </main>
</BaseLayout>

<style>
  .analytics-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .analytics-header {
    margin-bottom: 4rem;
  }

  .analytics-header h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-family: var(--font-sans);
    color: var(--color-text-dim);
    font-size: 1.1rem;
  }

  .stat-section {
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-dim);
    margin-bottom: 1.5rem;
    font-family: var(--font-sans);
  }

  /* Progress Card */
  .progress-card {
    background: #fdfdfd;
    border: 1px solid var(--color-border);
    padding: 2rem;
    border-radius: 8px;
  }

  .progress-info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .progress-numbers {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .progress-bar-container {
    height: 12px;
    background: #eee;
    border-radius: 6px;
    margin: 1.5rem 0;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: #111;
    border-radius: 6px;
    transition: width 0.5s ease-out;
  }

  .progress-status {
    font-size: 0.9rem;
    color: var(--color-text-dim);
    margin: 0;
  }

  /* Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .stat-card {
    border: 1px solid var(--color-border);
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-dim);
  }

  /* Details Layout */
  .details-layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2rem;
  }

  .insights-box, .authors-box {
    border: 1px solid var(--color-border);
    padding: 2rem;
    border-radius: 8px;
  }

  .ai-summary {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    font-style: italic;
  }

  .insight-meta {
    display: flex;
    gap: 2rem;
  }

  .meta-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--color-text-dim);
    font-family: var(--font-sans);
  }

  .meta-value {
    font-weight: 600;
    text-transform: capitalize;
  }

  .author-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .author-item {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #f5f5f5;
  }

  .author-count {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-dim);
  }

  .analytics-footer {
    margin-top: 4rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-text-dim);
    font-family: var(--font-sans);
  }

  @media (max-width: 768px) {
    .details-layout {
      grid-template-columns: 1fr;
    }
    
    .analytics-header h1 {
      font-size: 2.5rem;
    }
  }
</style>
