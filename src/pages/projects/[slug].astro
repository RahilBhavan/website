---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

export const prerender = true

export async function getStaticPaths() {
  const projects = await getCollection('projects')

  return projects.map((project) => {
    const slug = project.id.replace(/\.(md|mdx)$/, '')
    return {
      params: { slug },
      props: { project },
    }
  })
}

const { project } = Astro.props
const { Content, headings } = await project.render()
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <div class="project-layout">
    {headings && headings.length > 0 && (
      <aside class="toc-sidebar">
        <div class="toc-container">
          <h2 class="toc-title">On this page</h2>
          <nav>
            <ul>
              {headings
                .filter((h) => h.depth <= 3)
                .map((h) => (
                  <li class={`toc-item depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
            </ul>
          </nav>
        </div>
      </aside>
    )}

    <article class="project-container">
      <div class="project-header">
        <a href="/projects" class="back-link">← Projects</a>
        <h1 class="project-title">{project.data.title}</h1>
        <p class="project-description">{project.data.description}</p>

        <div class="project-meta">
          <time class="project-date" datetime={project.data.completedDate.toISOString()}>
            {project.data.completedDate.toLocaleDateString('en-us', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {(project.data.demoUrl || project.data.githubUrl) && <span class="project-meta-separator">•</span>}
          {project.data.demoUrl && (
            <a class="meta-link" href={project.data.demoUrl} target="_blank" rel="noopener noreferrer">
              demo
            </a>
          )}
          {project.data.demoUrl && project.data.githubUrl && <span class="project-meta-separator">•</span>}
          {project.data.githubUrl && (
            <a class="meta-link" href={project.data.githubUrl} target="_blank" rel="noopener noreferrer">
              code
            </a>
          )}
        </div>

        <div class="project-kicker">
          <div class="kicker-item">
            <span class="kicker-label">Problem</span>
            <span class="kicker-value">{project.data.problem}</span>
          </div>
          <div class="kicker-item">
            <span class="kicker-label">Solution</span>
            <span class="kicker-value">{project.data.solution}</span>
          </div>
        </div>
      </div>

      <div class="project-content">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .project-layout {
    display: flex;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    gap: 4rem;
  }

  .toc-sidebar {
    width: 250px;
    flex-shrink: 0;
    display: none;
  }

  @media (min-width: 1024px) {
    .toc-sidebar {
      display: block;
    }
  }

  .toc-container {
    position: sticky;
    top: 4rem;
    padding: 1rem 0;
  }

  .toc-title {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666;
    margin-bottom: 1rem;
    font-family: var(--font-sans);
  }

  .toc-item {
    margin: 0.5rem 0;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .toc-item a {
    color: #666;
    text-decoration: none;
    transition: color 0.2s;
  }

  .toc-item a:hover {
    color: #1a1a1a;
  }

  .toc-item.depth-3 {
    padding-left: 1rem;
    font-size: 0.85rem;
  }

  .project-container {
    flex: 1;
    max-width: 860px;
    padding: 4rem 2rem;
    min-width: 0;
  }

  .project-header {
    margin-bottom: 3rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 1.5rem;
    transition: opacity 0.2s;
    font-family: var(--font-sans);
  }

  .back-link:hover {
    opacity: 0.6;
  }

  .project-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .project-description {
    margin: 0 0 1.25rem 0;
    color: #666;
    line-height: 1.6;
    font-family: var(--font-sans);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 2rem;
    font-family: var(--font-sans);
    flex-wrap: wrap;
  }

  .project-meta-separator {
    color: #999;
  }

  .meta-link {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .project-kicker {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1.25rem 0;
    display: grid;
    gap: 1rem;
  }

  .kicker-item {
    display: grid;
    gap: 0.35rem;
  }

  .kicker-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #999;
    font-family: var(--font-sans);
  }

  .kicker-value {
    color: #1a1a1a;
    line-height: 1.55;
  }

  .project-content {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #1a1a1a;
  }

  .project-content :global(h2) {
    font-size: 2rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .project-content :global(h3) {
    font-size: 1.5rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .project-content :global(p) {
    margin: 1.25rem 0;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    margin: 1.25rem 0;
    padding-left: 2rem;
  }

  .project-content :global(li) {
    margin: 0.5rem 0;
  }

  .project-content :global(code) {
    background-color: #f5f5f5;
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
    font-family: var(--font-mono);
  }

  .project-content :global(pre) {
    background-color: #f5f5f5;
    padding: 1.25rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .project-content :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  .project-content :global(a) {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .project-content :global(a:hover) {
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .project-container {
      padding: 2rem 1.5rem;
    }

    .project-title {
      font-size: 2rem;
    }

    .project-content {
      font-size: 1rem;
    }
  }
</style>

