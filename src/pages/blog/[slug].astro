---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import MermaidInit from '../../components/MermaidInit.astro';
import SeriesLinks from '../../components/SeriesLinks.astro';

export const prerender = true;

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog', ({ data }) => {
    return data.draft !== true;
  });

  return blogPosts.map((post) => {
    // Remove .md or .mdx extension from id to create clean URLs
    const slug = post.id.replace(/\.(md|mdx)$/, '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// Calculate reading time
const wordCount = post.body ? post.body.split(/\s+/g).length : 0;
const readingTimeMinutes = Math.max(1, Math.round(wordCount / 200));
const readingTime = `${readingTimeMinutes} min read`;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="post-layout">
    {headings && headings.length > 0 && (
      <aside class="toc-sidebar">
        <div class="toc-container">
          <h2 class="toc-title">On this page</h2>
          <nav>
            <ul>
              {headings
                .filter((h) => h.depth <= 3)
                .map((h) => (
                  <li class={`toc-item depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
            </ul>
          </nav>
        </div>
      </aside>
    )}
    
    <article class="post-container">
      <div class="post-header">
        <a href="/blog" class="back-link">← Blog</a>
        <h1 class="post-title">{post.data.title}</h1>
        <div class="post-meta">
          <span class="post-author">Rahil Bhavan</span>
          {post.data.tags && post.data.tags.length > 0 && (
            <span class="post-tag">{post.data.tags[0]}</span>
          )}
        </div>
        <div class="post-meta-secondary">
          <time 
            class="post-meta-date"
            datetime={post.data.publishDate.toISOString()}
          >
            {post.data.publishDate.toLocaleDateString('en-us', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <span class="post-meta-separator">•</span>
          <span class="post-read-time">{readingTime}</span>
        </div>
      </div>

      {post.data.series && (
        <SeriesLinks 
          seriesName={post.data.series.name} 
          currentPart={post.data.series.part} 
        />
      )}

      <div class="post-content">
        <Content />
      </div>
    </article>
  </div>
  <MermaidInit />
</BaseLayout>

<style>
  .post-layout {
    display: flex;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    gap: 4rem;
  }

  .toc-sidebar {
    width: 250px;
    flex-shrink: 0;
    display: none; /* Hidden on mobile */
  }

  @media (min-width: 1024px) {
    .toc-sidebar {
      display: block;
    }
  }

  .toc-container {
    position: sticky;
    top: 4rem;
    padding: 1rem 0;
  }

  .toc-title {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666;
    margin-bottom: 1rem;
    font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .toc-item {
    margin: 0.5rem 0;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .toc-item a {
    color: #666;
    text-decoration: none;
    transition: color 0.2s;
  }

  .toc-item a:hover {
    color: #1a1a1a;
  }

  .toc-item.depth-3 {
    padding-left: 1rem;
    font-size: 0.85rem;
  }

  .post-container {
    flex: 1;
    max-width: 800px;
    padding: 4rem 2rem;
    min-width: 0; /* Important for flex child with code blocks */
  }

  .post-header {
    margin-bottom: 3rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 1.5rem;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.6;
  }

  .post-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    color: #1a1a1a;
  }

  .post-author {
    font-weight: 400;
  }

  .post-tag {
    background-color: #e3f2fd;
    color: #1976d2;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: capitalize;
  }

  .post-meta-secondary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 2rem;
  }

  .post-meta-date {
    color: #666;
  }

  .post-meta-separator {
    color: #999;
  }

  .post-read-time {
    color: #666;
  }

  .post-content {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #1a1a1a;
  }

  .post-content :global(p:first-of-type strong) {
    font-weight: 600;
  }

  .post-content :global(h2) {
    font-size: 2rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .post-content :global(p) {
    margin: 1.25rem 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1.25rem 0;
    padding-left: 2rem;
  }

  .post-content :global(li) {
    margin: 0.5rem 0;
  }

  .post-content :global(code) {
    background-color: #f5f5f5;
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
  }

  .post-content :global(pre) {
    background-color: #f5f5f5;
    padding: 1.25rem;
    border-radius: 4px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .post-content :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid #e5e5e5;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: #666;
    font-style: italic;
  }

  .post-content :global(a) {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(a:hover) {
    opacity: 0.7;
  }

  .post-content :global(.mermaid-diagram) {
    margin: 2rem 0;
    padding: 1.5rem;
    background-color: #f9fafb;
    border-radius: 8px;
    overflow-x: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
  }

  .post-content :global(.mermaid-diagram svg) {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .post-container {
      padding: 2rem 1.5rem;
    }

    .post-title {
      font-size: 2rem;
    }

    .post-content {
      font-size: 1rem;
    }
  }
</style>

